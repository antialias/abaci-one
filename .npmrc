# Prevent native addon builds for packages that have prebuilds or are optional
# canvas is an optional dep of jsdom (for testing) - doesn't compile on Alpine/musl
neverBuiltDependencies[]=canvas

# Gitea npm registry for @tidepool/* packages
@tidepool:registry=https://git.dev.abaci.one/api/packages/antialias/npm/

# Gitea npm registry for @eink/* packages (print-dialog, frames-engine).
# NOTE: the /api/v1/packages/... URL form 403s anonymously — keep the no-v1 form.
@eink:registry=https://git.dev.abaci.one/api/packages/antialias/npm/
