# Copy this to terraform.tfvars and fill in values

# Required
letsencrypt_email = "your-email@example.com"
auth_secret       = "generate-with-openssl-rand-base64-32"
# auth_secret_previous = "the-old-auth-secret"  # only during a rotation: keeps guest tokens valid for their 30 days (see variables.tf before using it for a disclosed secret)
# kid_songs_sync_token      = "set-a-secret-of-at-least-16-characters"
# kid_songs_sync_player_ids     = "player-id-one,player-id-two"
# kid_songs_doorbell_url        = "http://192.168.86.51:9117/v1/abaci-song-sync"
# kid_songs_doorbell_secret     = "set-a-secret-of-at-least-32-characters"

# Optional - realtime voice (the only feature still calling OpenAI directly)
# openai_api_key    = "sk-..."

# Optional - image generation through the switch proxy's Images API (by image class)
# switch_media_url   = "http://192.168.86.51:8788"
# switch_media_login = "..."                                # the app's proxy login

# Optional - text and vision calls as `claude -p` through the claude-switch-proxy
# llm_switch_api_key       = "..."                         # the proxy's client secret (feeds LLM_CLAUDE_CODE_API_KEY)
# llm_claude_code_model    = "claude-sonnet-5"             # or "claude-abaci" once the brain has that class
# Optional - ElevenLabs music through the proxy's door
# elevenlabs_api_base_url  = "http://192.168.86.51:8788/elevenlabs"
# elevenlabs_music_api_key = "<base64 of abaci:password>"  # the proxy login, not an ElevenLabs key

# Optional - Stripe billing (product, prices, and webhook are auto-created by Terraform)
# stripe_secret_key = "sk_live_..."

# Optional - Web Push notifications (VAPID keys)
# Generate with: npx web-push generate-vapid-keys --json
# vapid_public_key  = "B..."
# vapid_private_key = "..."

# Optional overrides
# app_domain        = "abaci.one"
# app_image         = "ghcr.io/antialias/soroban-abacus-flashcards:latest"
# app_replicas      = 2
# use_staging_certs = true  # Set to true when testing to avoid rate limits
