    {
      "id": 22,
      "type": "table",
      "title": "Provider failovers (24h)",
      "description": "Empty/No data is the healthy steady state \u2014 the series only appears once a failover happens. Non-zero means the proxy moved lanes; cross-reference https://scry.haunt.house/delegation.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
