      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "endpoint": true,
              "instance": true,
              "job": true,
              "namespace": true,
              "service": true,
              "container": true,
              "pod": true,
              "tier": true,
              "group": true
            },
            "renameByName": {
              "account": "Account",
              "kind": "Limit",
              "scope_model": "Model",
              "Value": "% used"
            },
            "indexByName": {
              "account": 0,
              "kind": 1,
              "scope_model": 2,
              "Value": 3
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "% used",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "% used"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.width",
                "value": 110
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "value": null,
                      "color": "green"
                    },
                    {
                      "value": 60,
                      "color": "yellow"
                    },
                    {
                      "value": 80,
                      "color": "orange"
                    },
                    {
                      "value": 90,
                      "color": "red"
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Limit"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "session": {
                        "text": "5-hour session",
                        "index": 0
                      },
                      "weekly_all": {
                        "text": "Weekly — everything",
                        "index": 1
                      },
                      "weekly_scoped": {
                        "text": "Weekly — model cap",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Model"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "special",
                    "options": {
                      "match": "empty",
                      "result": {
                        "text": "all",
                        "index": 0
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "Every rate limit Anthropic tracks for each account, one row per limit, sorted hottest-first. 'Weekly — model cap' rows are the per-model scoped caps (e.g. Fable) that can max out even while the overall weekly looks fine — ClaudeModelCapMaxed alerts on those."
