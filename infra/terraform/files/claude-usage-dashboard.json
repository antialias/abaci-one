{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "type": "dashboard",
        "enable": true,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "name": "Annotations & Alerts"
      },
      {
        "name": "Account switchover",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "purple",
        "expr": "changes(claude_usage_preferred[2m]) > 0 and claude_usage_preferred == 1",
        "titleFormat": "🔀 Account switchover",
        "textFormat": "now routing to {{account}}",
        "step": "60s"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 101,
      "type": "stat",
      "title": "Weekly headroom (best account)",
      "description": "100 − min(7-day utilization) across all *routable* accounts (`claude:combined_headroom:percent`). This is the real runway: the switch-proxy routes to whichever account is coolest, so Claude only dies when THIS hits zero. Accounts with stale data (dead token) are excluded — a stale account's last-good number is a lie and would otherwise make this look healthy while the live account burns down.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "claude:combined_headroom:percent",
          "legendFormat": "headroom",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 10,
                "color": "orange"
              },
              {
                "value": 25,
                "color": "yellow"
              },
              {
                "value": 40,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      }
    },
