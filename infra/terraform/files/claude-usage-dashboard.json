          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "claude_usage_lane_preferred == 1",
          "legendFormat": "{{lane}} → {{account}}",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "showValue": "never",
        "rowHeight": 0.9,
        "mergeValues": true,
        "alignValue": "center",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
