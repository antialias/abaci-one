    {
      "type": "stat",
      "title": "Compactions per active hour",
      "description": "Active hour = summed turn duration, so idle terminals do not dilute it. This is the number every lever below is trying to move.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(cc_compactions_total{arm=~\"$arm\",project=~\"$project\",exp=~\"$exp\",scenario=~\"$scenario\"}[$__range])) / (sum(increase(cc_turn_duration_seconds_sum{arm=~\"$arm\",project=~\"$project\",exp=~\"$exp\",scenario=~\"$scenario\"}[$__range])) / 3600)",
          "legendFormat": "all",
          "instant": true,
          "range": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
