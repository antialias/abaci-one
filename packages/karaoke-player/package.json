{
  "name": "@tidepool/karaoke-player",
  "version": "0.1.1",
  "description": "Portable React karaoke playback with resilient ElevenLabs word alignment",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "pnpm clean && panda codegen && panda cssgen --outfile dist/styles.css && tsup",
    "clean": "rm -rf dist styled-system",
    "codegen": "panda codegen",
    "compat:react": "node scripts/verify-react-compat.mjs",
    "dev": "panda codegen && mkdir -p dist && concurrently \"panda cssgen --watch --outfile dist/styles.css\" \"tsup --watch\"",
    "lint": "eslint .",
    "pack:verify": "node scripts/verify-pack.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "type-check": "panda codegen && tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@pandacss/dev": "1.12.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "concurrently": "^8.0.0",
    "eslint": "^8.0.0",
    "globals": "^16.5.0",
    "jsdom": "^27.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.52.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://git.dev.abaci.one/api/packages/antialias/npm/"
  }
}
